{
    "name": "monitaurus/igor-doctor-runtime",
    "description": "Runtime probe for igor:doctor: replays requests on one booted kernel and reports the state that survives between them.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "symfony/console": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/dependency-injection": "^5.4 || ^6.4 || ^7.0 || ^8.0",
        "symfony/http-kernel": "^5.4 || ^6.4 || ^7.0 || ^8.0"
    },
    "autoload": {
        "psr-4": {
            "IgorDoctor\\Runtime\\": "src/"
        }
    }
}
