{
    "name": "monitaurus/igor-doctor",
    "description": "Symfony console command that fixes Igor worker-mode findings with an AI agent, verified by Igor itself.",
    "type": "project",
    "license": "MIT",
    "minimum-stability": "stable",
    "prefer-stable": true,
    "require": {
        "php": ">=8.2",
        "ext-ctype": "*",
        "ext-iconv": "*",
        "symfony/ai-agent": "0.15.0",
        "symfony/ai-claude-code-platform": "0.15.0",
        "symfony/ai-platform": "0.15.0",
        "symfony/console": "7.4.*",
        "symfony/dotenv": "7.4.*",
        "symfony/filesystem": "7.4.*",
        "symfony/framework-bundle": "7.4.*",
        "symfony/mcp-bundle": "0.15.0",
        "symfony/process": "7.4.*",
        "symfony/runtime": "7.4.*",
        "symfony/yaml": "7.4.*"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/security-bundle": "7.4.*"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true,
        "platform": {
            "php": "8.2.0"
        }
    },
    "autoload": {
        "psr-4": {
            "IgorDoctor\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IgorDoctor\\Tests\\": "tests/",
            "IgorDoctor\\Runtime\\": "runtime/src/",
            "IgorDoctor\\Runtime\\Tests\\": "runtime/tests/"
        }
    },
    "scripts": {
        "git-hooks": "git rev-parse --is-inside-work-tree > /dev/null 2>&1 && git config core.hooksPath .githooks || true",
        "post-install-cmd": [
            "@git-hooks"
        ],
        "post-update-cmd": [
            "@git-hooks"
        ]
    }
}
