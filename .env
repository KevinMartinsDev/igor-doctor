# Committed defaults. Put local values in .env.local, which is not committed.
APP_ENV=dev
APP_SECRET=change-me

# AI agent: the local Claude Code CLI, logged in with your own Claude account (no API key).
# Set the model in .env.local; the command lists the accepted values when it is missing.
DOCTOR_AI_MODEL=
# Path to the "claude" CLI, when it is not on the PATH.
DOCTOR_CLAUDE_BIN=
# Seconds the agent may take to answer one finding (default 600). A finding that times out gets no patch.
DOCTOR_AGENT_TIMEOUT=
